{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git worktree *)",
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx eslint *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.toptal.com)",
      "WebFetch(domain:gist.github.com)",
      "Bash(gh api:*)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(for *)",
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git merge *)",
      "Bash(git clean *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(npx vitest *)",
      "Bash(npx vite *)",
      "Bash(sed -i *)",
      "Bash(python3 *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(pkill -f *)",
      "Bash(jq *)",
      "Bash(curl -s *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(awk *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(true)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/allow-readonly-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
